{
  "name": "audio-extractor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "npm run prepare:ffmpeg && vite",
